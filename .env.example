# ---- ClassInteract configuration (copy to .env) ----

# Port the server listens on
PORT=3001

# SQLite database. In dev this path is relative to server/prisma/.
# Docker uses file:/data/classinteract.db
DATABASE_URL="file:../data/classinteract.db"

# Where uploaded images and the generated secret live (defaults to ./data next to where the server starts)
# DATA_DIR=./data

# The public address people use to reach the app. Used for the QR code on the projector.
# Set it when running behind a domain or Cloudflare Tunnel, e.g. https://class.example.com
# PUBLIC_URL=https://class.example.com

# Protects the Presenter Studio (create/edit/run sessions). STRONGLY recommended on any public deployment.
# Participants never need it. Leave empty only for local, single-user use.
# STUDIO_PASSWORD=change-me

# Secret used to sign presenter/projector links. Generated and stored in DATA_DIR if left empty.
# SERVER_SECRET=

# Reverse proxy / tunnel: number of proxy hops to trust for client IPs (Cloudflare Tunnel: 1)
# TRUST_PROXY=1

# Limits
# MAX_PARTICIPANTS=500
# SESSION_IDLE_HOURS=24

# Import the "MSG: The Secret Ingredient?" demo on first start when the library is empty
# AUTO_SEED=true

# Extra words to block in names and responses, comma separated
# EXTRA_BLOCKED_WORDS=
