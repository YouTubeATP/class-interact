# ---- ClassInteract configuration (copy to .env) ----

# Port the server (API, and the whole app in production) listens on
PORT=3001

# Port the dev server (`npm run dev`, with hot reload) listens on. Open this one while developing.
# WEB_PORT=5173

# SQLite database. In dev this path is relative to server/prisma/.
# Docker uses file:/data/classinteract.db
DATABASE_URL="file:../data/classinteract.db"

# Where uploaded images and the generated secret live (defaults to ./data next to where the server starts)
# DATA_DIR=./data

# The public address people use to reach the app. Used for the QR code on the projector.
# Set it when running behind a domain or Cloudflare Tunnel, e.g. https://class.example.com
# PUBLIC_URL=https://class.example.com

# Serving `npm run dev` itself through a Cloudflare Tunnel (point the tunnel at http://localhost:<WEB_PORT>):
# Vite rejects unknown hostnames, so list yours (PUBLIC_URL's host is allowed automatically). * allows any.
# ALLOWED_HOSTS=class.example.com
# Hot reload through an https tunnel needs the browser to use the tunnel's port:
# HMR_CLIENT_PORT=443

# Protects the Presenter Studio (create/edit/run sessions). STRONGLY recommended on any public deployment.
# Participants never need it. Leave empty only for local, single-user use.
# STUDIO_PASSWORD=change-me

# Secret used to sign presenter/projector links. Generated and stored in DATA_DIR if left empty.
# SERVER_SECRET=

# Reverse proxy / tunnel: number of proxy hops to trust for client IPs (Cloudflare Tunnel: 1)
# TRUST_PROXY=1

# Limits
# MAX_PARTICIPANTS=500
# SESSION_IDLE_HOURS=24

# Import the "MSG: The Secret Ingredient?" demo on first start when the library is empty
# AUTO_SEED=true

# AI presentation assistant (the chat in the editor). Off unless AIMLAPI_KEY is set. The key stays on the server and is
# never sent to browsers. Any OpenAI-compatible service works: change AI_BASE_URL and AI_MODEL.
# AIMLAPI_KEY=
# AI_MODEL=deepseek/deepseek-v4.1-flash
# AI_BASE_URL=https://api.aimlapi.com/v1

# Extra words to block in names and responses, comma separated
# EXTRA_BLOCKED_WORDS=

# ---- Docker Compose only ----
# PORT (above) is also the port inside the container; the tunnel's service URL is then http://app:<PORT>.
# Port published on the host (defaults to PORT)
# HOST_PORT=3001
# Cloudflare Tunnel token (docker compose --profile tunnel up -d)
# TUNNEL_TOKEN=
