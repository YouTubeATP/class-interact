generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A reusable presentation: metadata + theme. Its ordered slides are `Activity` rows.
model Presentation {
  id            String     @id @default(cuid())
  title         String
  description   String     @default("")
  /// JSON: { palette, background }
  theme         String
  schemaVersion Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    Activity[]
  sessions      Session[]
}

/// One slide / activity of a presentation. `key` is the slide id inside the JSON document.
model Activity {
  id             String       @id @default(cuid())
  presentationId String
  key            String
  position       Int
  type           String
  /// JSON: the slide's configuration (the slide document minus `id` and `type`)
  config         String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([presentationId, key])
  @@index([presentationId, position])
}

/// A live (or finished) run of a presentation. Slides are copied into SessionActivity so that
/// editing or deleting the presentation never changes a session's results.
model Session {
  id             String            @id @default(cuid())
  presentationId String?
  title          String
  theme          String
  mode           String            @default("standalone")
  collectNames   Boolean           @default(true)
  /// live | ended
  status         String            @default("live")
  pin            String
  /// Equal to `pin` while live, NULL once ended — so a PIN is unique among live sessions only.
  livePin        String?           @unique
  /// Six digits typed on a screen-side computer to turn it into this session's projector. Separate from `pin`
  /// (which only lets people join), and NULL once the session has ended.
  liveProjectorCode String?        @unique
  /// JSON: SessionState (phase, activity index, visibility flags, timer)
  state          String
  /// JSON: SessionFeatures (Q&A, pulse, teams, projector look and sound, self-paced, …). '{}' = defaults.
  features       String            @default("{}")
  /// A rehearsal with simulated participants: excluded from analytics and cross-session reports.
  rehearsal      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  endedAt        DateTime?
  lastActivityAt DateTime          @default(now())
  presentation   Presentation?     @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  activities     SessionActivity[]
  participants   Participant[]
  submissions    Submission[]
  runs           ActivityRun[]
  teams          Team[]
  questions      AudienceQuestion[]
  pulses         PulseSignal[]
  pulseEvents    PulseEvent[]
  grants         AccessGrant[]

  @@index([status])
}

model SessionActivity {
  id              String       @id @default(cuid())
  sessionId       String
  key             String
  position        Int
  type            String
  config          String
  completed       Boolean      @default(false)
  answerRevealed  Boolean      @default(false)
  /// Private shuffle seed for match / order questions. Never sent to any client: it is what keeps the shuffled
  /// ids shown to phones and the projector from revealing the answer. Empty for rows created before it existed.
  seed            String       @default("")
  session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions     Submission[]
  runs            ActivityRun[]

  @@unique([sessionId, key])
  @@index([sessionId, position])
}

model Participant {
  id          String       @id @default(cuid())
  sessionId   String
  name        String
  nameKey     String
  /// SHA-256 of the participant's secret token (the token itself is never stored)
  tokenHash   String       @unique
  removed     Boolean      @default(false)
  joinedAt    DateTime     @default(now())
  /// Team mode (optional)
  teamId      String?
  /// "Remember me" identity across sessions (opt-in, continuity sessions only)
  learnerId   String?
  /// A rehearsal's simulated participant
  simulated   Boolean      @default(false)
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions Submission[]
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  learner     Learner?     @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  votes       QuestionVote[]

  @@unique([sessionId, nameKey])
  @@index([learnerId])
}

/// One run of an activity in a session. The first run is created with the session; "run again" adds more, each
/// with its own responses, reveal state, moderation and scoring rule.
model ActivityRun {
  id                String          @id @default(cuid())
  sessionId         String
  sessionActivityId String
  /// 1, 2, 3…
  number            Int
  /// counted | practice | replace | add
  scoring           String          @default("counted")
  answerRevealed    Boolean         @default(false)
  completed         Boolean         @default(false)
  startedAt         DateTime        @default(now())
  /// JSON: word-cloud term merges { termKey: groupKey }
  merges            String          @default("{}")
  session           Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activity          SessionActivity @relation(fields: [sessionActivityId], references: [id], onDelete: Cascade)
  submissions       Submission[]

  @@unique([sessionActivityId, number])
  @@index([sessionId])
}

model Team {
  id           String        @id @default(cuid())
  sessionId    String
  name         String
  color        String
  position     Int
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@index([sessionId])
}

/// Audience Q&A, independent of the slides.
model AudienceQuestion {
  id            String         @id @default(cuid())
  sessionId     String
  participantId String?
  anonymous     Boolean        @default(false)
  /// Copied when asked (null when anonymous), so renaming later does not rewrite history
  authorName    String?
  text          String
  /// pending | visible | hidden | dismissed
  status        String         @default("visible")
  pinned        Boolean        @default(false)
  answered      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  answeredAt    DateTime?
  session       Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes         QuestionVote[]

  @@index([sessionId])
}

model QuestionVote {
  id            String           @id @default(cuid())
  questionId    String
  participantId String
  createdAt     DateTime         @default(now())
  question      AudienceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([questionId, participantId])
}

/// Each participant's current understanding signal. Shown to the presenter only as counts.
model PulseSignal {
  sessionId     String
  participantId String
  /// got | unsure | lost
  value         String
  updatedAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, participantId])
}

/// Anonymous log of pulse changes (no participant id), for the trend line.
model PulseEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  /// the new value, or "" when cleared
  value     String
  /// the previous value, or ""
  previous  String
  at        DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
}

/// Revocable access link for a co-presenter or moderator. Only the SHA-256 of the token is stored.
model AccessGrant {
  id        String    @id @default(cuid())
  sessionId String
  /// copresenter | moderator
  role      String
  label     String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Optional, opt-in identity that lets a person be recognised across sessions. Holds no name and no contact details:
/// only a hash of the random key kept on the person's device, and an optional label the presenter gives it.
model Learner {
  id            String        @id @default(cuid())
  keyHash       String        @unique
  /// The person agreed that the teacher may see their own progress (otherwise only class-level aggregates)
  shareProgress Boolean       @default(false)
  label         String        @default("")
  createdAt     DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())
  participants  Participant[]
}

model Submission {
  id                String          @id @default(cuid())
  sessionId         String
  sessionActivityId String
  runId             String
  participantId     String
  /// 0..maxSubmissions-1. Together with the unique index below this makes double submissions impossible.
  slot              Int
  /// JSON payload (shape depends on the activity type)
  payload           String
  /// Normalised text key (word clouds). NULL for other types; unique per participant when set.
  key               String?
  /// visible | pending | hidden
  status            String          @default("visible")
  correct           Boolean?
  score             Int             @default(0)
  responseMs        Int?
  /// Typed / numeric / hotspot answers the grader was unsure about: pending | accepted | rejected (NULL otherwise)
  review            String?
  /// Plain-language grading explanation
  detail            String?
  createdAt         DateTime        @default(now())
  session           Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activity          SessionActivity @relation(fields: [sessionActivityId], references: [id], onDelete: Cascade)
  run               ActivityRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  participant       Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([runId, participantId, slot])
  @@unique([runId, participantId, key])
  @@index([sessionId])
  @@index([sessionActivityId, status])
  @@index([runId, status])
}
